{
  "name": "xrift-studio",
  "private": true,
  "version": "0.10.3",
  "description": "Community-built desktop app for creating XRift worlds and items",
  "type": "module",
  "license": "MIT",
  "author": "xrift-studio contributors",
  "bin": {
    "xrift-studio": "./dist/cli/xrift-studio.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "release:snapshot": "node scripts/fetch-release-snapshot.mjs",
    "build:preview": "vite build --config vite.preview.config.ts",
    "preview:guide": "vite --config vite.preview.config.ts",
    "build:guide": "node scripts/build-guide.mjs",
    "starter:sync:xrift-official": "node scripts/sync-xrift-official-starter-assets.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "mcp:sidecar:prepare": "node scripts/prepare-mcp-sidecar.mjs",
    "mcp:sidecar:prepare:release": "node scripts/prepare-mcp-sidecar.mjs --release",
    "mcp:server": "node scripts/mcp-debug-server.mjs",
    "mcp:debug-config": "node scripts/mcp-debug-config.mjs",
    "mcp:cli": "pnpm --package=@hypothesi/tauri-mcp-cli dlx tauri-mcp",
    "e2e:typecheck": "tsc --noEmit -p tsconfig.e2e.json",
    "e2e:test": "playwright test --config playwright.config.ts",
    "e2e:smoke": "playwright test --config playwright.config.ts e2e/release-gate.spec.ts --grep @release-smoke",
    "e2e:release": "pnpm typecheck && pnpm e2e:typecheck && pnpm e2e:smoke",
    "cli:build": "vite build --config vite.cli.config.mjs",
    "mcp:tool-names": "node scripts/generate-mcp-tool-names.mjs",
    "cli:test": "node scripts/check-world-components-alignment.mjs && node scripts/check-fixture-coverage.mjs && node scripts/generate-mcp-tool-names.mjs --check && pnpm cli:build && node dist/cli/fixture.mjs",
    "runtime:build": "pnpm --filter xrift-studio-runtime build",
    "runtime:typecheck": "pnpm --filter xrift-studio-runtime typecheck",
    "runtime:shell:check": "node scripts/check-world-runtime-shell.mjs",
    "recording:summarize": "node scripts/summarize-recording.mjs",
    "test:guide": "node --test scripts/guide.test.mjs",
    "guide:capture": "node scripts/guide/capture-guide.mjs capture",
    "guide:media": "node scripts/guide/capture-guide.mjs list"
  },
  "overrides": {
    "dompurify": "3.4.12"
  },
  "dependencies": {
    "@fontsource/noto-sans-jp": "5.3.0",
    "@gltf-transform/core": "4.5.0",
    "@gltf-transform/extensions": "4.5.0",
    "@gltf-transform/functions": "4.5.0",
    "@monaco-editor/react": "4.7.0",
    "@pixiv/three-vrm": "3.5.5",
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.7.0",
    "@react-three/rapier": "2.2.0",
    "@react-three/uikit": "1.0.76",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@tauri-apps/plugin-os": "2.3.2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "2.3.6",
    "@tauri-apps/plugin-updater": "^2.12.0",
    "@xrift/sdk": "^0.1.3",
    "@xrift/world-components": "0.55.0",
    "@xyflow/react": "12.11.6",
    "draco3dgltf": "1.5.7",
    "hls.js": "1.7.3",
    "ktx2-encoder": "0.6.0",
    "lucide-react": "1.47.0",
    "meshoptimizer": "^1.2.0",
    "monaco-editor": "0.55.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "rhino3dm": "8.35.0",
    "three": "0.185.1",
    "three-icosa": "0.4.2-alpha.18",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "^2.11.5",
    "@types/node": "^26.6.2",
    "@types/react": "~19.2.18",
    "@types/react-dom": "~19.2.4",
    "@types/three": "0.185.1",
    "@vitejs/plugin-react": "^6.1.1",
    "draco3d": "1.5.7",
    "fake-indexeddb": "^6.2.5",
    "tailwindcss": "4.3.3",
    "typescript": "~7.0.2",
    "typescript-test-api": "npm:typescript@5.9.3",
    "vite": "^8.3.0"
  },
  "packageManager": "pnpm@11.19.0"
}
