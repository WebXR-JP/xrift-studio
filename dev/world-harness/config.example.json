{
  "adapter": "./stdio-adapter.mjs",
  "journal": "./.local/session.jsonl",
  "maxSteps": 30,
  "goal": {
    "blueprint": "用途、雰囲気、品質、床、主役、除外事項、予算、前提を記入する。",
    "criteria": ["スポーンから主役が見える", "俯瞰で配置と動線が確認できる", "metrics が設計図の予算内に収まる"]
  },
  "model": { "command": "node", "args": ["dev/world-harness/chat-model.mjs"] },
  "mcp": { "command": "C:/absolute/path/to/xrift-studio-mcp.exe", "args": [] },
  "captureDirectory": "C:/absolute/path/to/debug-captures",
  "captureArguments": { "projectId": "REPLACE", "sceneId": "REPLACE" },
  "cameras": {
    "spawn": { "projectId": "REPLACE", "sceneId": "REPLACE", "position": [0, 1.6, 5], "target": [0, 1, 0] },
    "iso": { "projectId": "REPLACE", "sceneId": "REPLACE", "preset": "iso" }
  },
  "effects": {
    "get_editor_context": "read",
    "list_entities": "read",
    "list_material_assets": "read",
    "capture_scene_debug": "read",
    "capture_scene_view": "view",
    "create_primitive": "write",
    "update_transform": "write"
  }
}
