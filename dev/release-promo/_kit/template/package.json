{
  "name": "xrift-promo-__SLUG__",
  "private": true,
  "type": "module",
  "scripts": {
    "audio": "node ../_kit/scripts/gen-audio.mjs",
    "sync": "node ../_kit/scripts/sync-assets.mjs",
    "studio": "node ../_kit/scripts/sync-assets.mjs && remotion studio",
    "render": "node ../_kit/scripts/sync-assets.mjs && remotion render Promo out/__SLUG__.mp4",
    "render:vertical": "node ../_kit/scripts/sync-assets.mjs && remotion render PromoVertical out/__SLUG__-vertical.mp4",
    "still": "node ../_kit/scripts/sync-assets.mjs && remotion still Promo --frame=230 out/__SLUG__-check.png",
    "still:vertical": "node ../_kit/scripts/sync-assets.mjs && remotion still PromoVertical --frame=230 out/__SLUG__-check-vertical.png",
    "typecheck": "tsc --noEmit"
  }
}
